<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ day }} 工作日报 · What-I-Did</title>
{% include "_style.html.j2" %}
</head>
<body>
<div class="wrap">

  <a class="back" href="../index.html">← 返回看板</a>

  <header class="hero">
    <div class="hero-top">
      <h1>{{ day }}<span class="wd">{{ weekday }}</span></h1>
      <div class="badges">
        {% if d.status == 'ok' %}<span class="badge ok">模型生成</span>
        {% elif d.status == 'degraded' %}<span class="badge warn">降级 · 仅时间线</span>
        {% else %}<span class="badge mute">空日</span>{% endif %}
        <span class="badge">第 {{ d.revision }} 版</span>
        {% if d.report.confidence %}<span class="badge">置信度 {{ d.report.confidence }}</span>{% endif %}
        <span class="badge">覆盖 {{ d.coverage.window }}</span>
        {% if d.meta.model %}<span class="badge">{{ d.meta.model }}</span>{% endif %}
      </div>
    </div>
    <p class="headline">{{ d.report.headline or '（无标题）' }}</p>
  </header>

  <div class="cards">
    <div class="card"><div class="n">{{ (d.stats.active_minutes / 60) | round(1) }}<small>h</small></div><div class="k">有效活动</div></div>
    <div class="card"><div class="n">{{ d.stats.block_count }}</div><div class="k">活动块</div></div>
    <div class="card"><div class="n">{{ rhythm.longest_focus_min or 0 }}<small>分</small></div><div class="k">最长连续专注</div></div>
    <div class="card"><div class="n">{{ rhythm.session_count or 0 }}</div><div class="k">连续工作段</div></div>
    <div class="card"><div class="n">{{ d.refs | length }}</div><div class="k">文档引用</div></div>
  </div>

  <section>
    <h2>一天概览 <span class="sub">{{ d.coverage.window }}{% if not d.coverage.complete %} · 当日未结束，21:00 后还会出终版{% endif %}</span></h2>
    <div class="daystrip">
      {% for s in segs %}
      <a class="seg" href="#{{ s.id }}" style="left:{{ s.left }}%;width:{{ s.width }}%;background:{{ s.color }}" title="{{ s.title }}"></a>
      {% endfor %}
    </div>
    <div class="ticks">{% for t in ticks %}<span>{{ t }}</span>{% endfor %}</div>
    <div class="legend">
      {% for key, label in cat_label.items() %}
      {% if key in d.stats.by_category %}
      <span><i style="background:{{ {'dev':'#2563eb','doc':'#0d9488','meet':'#d97706','comm':'#7c3aed','web':'#64748b','other':'#94a3b8'}[key] }}"></i>{{ label }} {{ d.stats.by_category[key] }} 分</span>
      {% endif %}
      {% endfor %}
    </div>
    {% if rhythm.longest_focus_min %}
    <div class="rhythm">
      <span>最长专注 <b>{{ rhythm.longest_focus_min }} 分</b>（{{ rhythm.longest_focus_at }}）</span>
      <span>被打断 <b>{{ rhythm.interruptions }}</b> 次</span>
      <span>碎片段 <b>{{ rhythm.fragmented_min }} 分</b>（{{ (rhythm.fragmented_ratio * 100) | round(0) | int }}%）</span>
      <span>整段工作 <b>{{ rhythm.deep_work_min }} 分</b></span>
      <span>活动最密 <b>{{ rhythm.peak_window }}</b></span>
    </div>
    {% endif %}
  </section>

  {% if d.report.opening_md %}
  <section>
    <h2>这一天是什么样的一天</h2>
    <div class="prose">
      {% for para in d.report.opening_md.split('\n\n') if para.strip() %}
      <p>{{ para | replace('\n', ' ') }}</p>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if behaviors %}
  <section>
    <h2>行为时间轴 <span class="sub">时间由本地按采集数据切，行为由模型推测；拿不准的标 ?</span></h2>
    <div class="daystrip tall">
      {% for s in bsegs %}
      <span class="seg" style="left:{{ s.left }}%;width:{{ s.width }}%;background:{{ s.color }}" title="{{ s.title }}"></span>
      {% endfor %}
    </div>
    <div class="ticks">{% for t in ticks %}<span>{{ t }}</span>{% endfor %}</div>
    <ul class="tl">
      {% for it in behaviors %}
      <li>
        <div class="t">{{ it.start }}–{{ it.end }}<div class="dur">{{ it.minutes }} 分</div></div>
        <div class="body">
          <div class="title"><span class="vdot" style="background:{{ (verbs.get(it.verb) or {}).get('color', '#94a3b8') }}"></span>{{ it.label }}{% if it.confidence == 'low' %}<span class="q">?</span>{% endif %}</div>
          {% if it.detail %}<div class="impact">{{ it.detail }}</div>{% endif %}
          <div class="chips">
            <span class="chip">{{ (verbs.get(it.verb) or {}).get('label', it.verb) }}</span>
            {% if it.switches %}<span class="chip">切换 {{ it.switches }} 次</span>{% endif %}
          </div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if d.report.offline %}
  <section>
    <h2>人工补录 <span class="sub">屏幕看不到的工作：会议、外出、思考。由本人登记，不计入屏幕活动统计</span></h2>
    <ul class="tl">
      {% for o in d.report.offline %}
      <li>
        <div class="t">{{ o.start }}–{{ o.end }}</div>
        <div class="body">
          <div class="title">{{ o.label }}</div>
          {% if o.note %}<div class="impact">{{ o.note }}</div>{% endif %}
          <div class="chips"><span class="chip">人工登记</span></div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section>
    <h2>过程</h2>
    <div class="prose">
      {% if d.report.summary_md %}
        {% for para in d.report.summary_md.split('\n\n') if para.strip() %}
          <p>{{ para | replace('\n', ' ') }}</p>
        {% endfor %}
      {% else %}
        <p class="empty">{{ d.report.notes_for_human or '这一天没有生成叙述性总结。' }}</p>
      {% endif %}
    </div>
  </section>

  <section>
    <h2>活动块明细 <span class="sub">按应用切分，点证据编号可跳到原始记录；用于核对上面每条推测</span></h2>
    <input class="search" id="tl-search" placeholder="过滤…（输入文件名、应用名、标题）">
    <ul class="tl" id="tl-list">
      {% if d.report.timeline %}
        {% for it in d.report.timeline %}
        <li data-text="{{ (it.title ~ ' ' ~ it.app)|lower }}">
          <div class="t">{{ it.start or '--:--' }}–{{ it.end or '--:--' }}</div>
          <div class="body">
            <div class="title">{{ it.title }}</div>
            <div class="chips">
              {% if it.app %}<span class="chip">{{ it.app }}</span>{% endif %}
              <span class="chip cat" style="background:{{ {'dev':'#2563eb','doc':'#0d9488','meet':'#d97706','comm':'#7c3aed','web':'#64748b','other':'#94a3b8'}.get(it.category, '#94a3b8') }}">{{ cat_label.get(it.category, it.category) }}</span>
              {% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}
            </div>
          </div>
        </li>
        {% endfor %}
      {% else %}
        {% for b in blocks %}
        <li data-text="{{ (b.title ~ ' ' ~ b.app)|lower }}">
          <div class="t">{{ b.start[11:16] }}–{{ b.end[11:16] }}</div>
          <div class="body">
            <div class="title">{{ b.title or b.app or '(无标题)' }}</div>
            <div class="chips">
              <span class="chip">{{ b.app or '-' }}</span>
              <span class="chip cat" style="background:{{ b._color }}">{{ b._cat_label }}</span>
              <span class="chip">{{ b.minutes }} 分</span>
              <a class="ev" href="#{{ b.id }}">{{ b.id }}</a>
            </div>
          </div>
        </li>
        {% endfor %}
      {% endif %}
    </ul>
    {% if not d.report.timeline and not blocks %}<p class="empty">没有时间线记录。</p>{% endif %}
  </section>

  {% set hi = d.report.highlights %}
  {% if hi %}
  <section>
    <h2>关键进展 <span class="sub">{{ hi | length }} 项</span></h2>
    <div class="grid2">
      {% for it in hi %}
      <div class="item">
        <div class="what">{{ it.what }}</div>
        {% if it.evidence %}<div class="impact"><b>证据</b>　<span class="mono">{{ it.evidence }}</span></div>{% endif %}
        {% if it.impact %}<div class="impact"><b>影响</b>　{{ it.impact }}</div>{% endif %}
        <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% set fr = d.report.friction %}
  {% if fr %}
  <section>
    <h2>卡点与代价 <span class="sub">花了多少时间、绕了多少路，也记下来</span></h2>
    <ul class="tl">
      {% for it in fr %}
      <li>
        <div class="t">卡点 {{ loop.index }}</div>
        <div class="body">
          <div class="title">{{ it.what }}</div>
          {% if it.cause %}<div class="impact"><b>原因</b>　{{ it.cause }}</div>{% endif %}
          {% if it.cost %}<div class="impact"><b>代价</b>　{{ it.cost }}</div>{% endif %}
          {% if it.fix %}<div class="impact"><b>处理</b>　{{ it.fix }}</div>{% endif %}
          <div class="chips">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% set ins = d.report.insight %}
  {% if ins %}
  <section>
    <h2>洞察 <span class="sub">对工作方式的判断，不是复述</span></h2>
    <div class="grid2">
      {% for it in ins %}
      <div class="item">
        <div class="what">{{ it.observation }}</div>
        {% if it.evidence %}<div class="impact"><b>依据</b>　{{ it.evidence }}</div>{% endif %}
        {% if it.action %}<div class="impact"><b>下次</b>　{{ it.action }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if not hi and d.report.accomplishments %}
  {% set acc = d.report.accomplishments %}
  <section>
    <h2>成果 <span class="sub">{{ acc | length }} 项</span></h2>
    <div class="grid2">
      {% for it in acc %}
      <div class="item">
        <div class="what">{{ it.what }}</div>
        {% if it.impact %}<div class="impact">{{ it.impact }}</div>{% endif %}
        <div class="foot">
          <span class="st {{ it.status }}">{{ {'done':'已完成','partial':'部分完成','blocked':'受阻'}.get(it.status, it.status) }}</span>
          {% if it.artifact and it.artifact.label %}
            {% set r = refs.get(it.artifact.ref_id) if it.artifact.ref_id else None %}
            {% if r %}
              <a class="refchip {{ r.kind }}" href="{{ r.uri }}" target="_blank" title="{{ r.uri }}">📄 {{ it.artifact.label }}</a>
            {% else %}
              <span class="refchip off">{{ it.artifact.label }}</span>
            {% endif %}
          {% endif %}
          {% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if d.report.in_progress or d.report.blockers %}
  <section>
    <h2>进行中 / 卡点</h2>
    <div class="grid2">
      <div>
        <h3>进行中</h3>
        {% for it in d.report.in_progress %}
        <div class="item" style="margin-bottom:10px">
          <div class="what">{{ it.what }}</div>
          {% if it.state %}<div class="impact">{{ it.state }}</div>{% endif %}
          {% if it.next %}<div class="impact"><b>下一步：</b>{{ it.next }}</div>{% endif %}
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% else %}<p class="empty">无</p>{% endfor %}
      </div>
      <div>
        <h3>卡点</h3>
        {% for it in d.report.blockers %}
        <div class="item" style="margin-bottom:10px">
          <div class="what">{{ it.what }}</div>
          {% if it.detail %}<div class="impact mono">{{ it.detail }}</div>{% endif %}
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% else %}<p class="empty">无</p>{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if d.report.decisions or d.report.learnings %}
  <section>
    <h2>决策与收获</h2>
    <div class="grid2">
      <div>
        <h3>决策</h3>
        {% for it in d.report.decisions %}
        <div class="item" style="margin-bottom:10px"><div class="what">{{ it.what }}</div>
          {% if it.why %}<div class="impact">{{ it.why }}</div>{% endif %}
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% else %}<p class="empty">无</p>{% endfor %}
      </div>
      <div>
        <h3>收获</h3>
        {% for it in d.report.learnings %}
        <div class="item" style="margin-bottom:10px"><div class="what">{{ it.what }}</div>
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% else %}<p class="empty">无</p>{% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {% if d.report.tomorrow %}
  <section>
    <h2>明天</h2>
    <ul class="tl">
      {% for it in d.report.tomorrow %}
      <li style="grid-template-columns:26px 1fr">
        <div class="t">☐</div>
        <div class="body"><div class="title">{{ it.item }}</div>{% if it.why %}<div class="impact">{{ it.why }}</div>{% endif %}</div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% set tb = d.report.time_breakdown %}
  {% if tb %}
  {% set maxmin = (tb | map(attribute='minutes') | max) or 1 %}
  <section>
    <h2>时间分布 <span class="sub">模型估计，仅供参照</span></h2>
    <div class="bars">
      {% for it in tb %}
      <div class="bar"><span>{{ it.category }}</span>
        <span class="track"><span class="fill" style="width:{{ (it.minutes / maxmin * 100) | round(1) }}%"></span></span>
        <span class="v">{{ it.minutes }} 分</span></div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if d.gaps %}
  <section>
    <h2>数据缺口</h2>
    <div class="callout">
      以下时段没有采集记录，可能是离开、开会、午休或采集被暂停：
      {% for g in d.gaps %}<b>{{ g.start }}–{{ g.end }}</b>（{{ g.minutes }} 分）{% if not loop.last %}、{% endif %}{% endfor %}
    </div>
  </section>
  {% endif %}

  {% if refs_list %}
  <section>
    <h2>相关文档 <span class="sub">本期只做跳转，不改动任何外部文档</span></h2>
    <div class="chips">
      {% for r in refs_list %}
        {% if r.clickable %}
        <a class="refchip {{ r.kind }}" href="{{ r.uri }}" target="_blank" title="{{ r.why }} · {{ r.uri }}">{{ r.label }}</a>
        {% else %}
        <span class="refchip off" title="{{ r.uri }}">{{ r.label }}</span>
        {% endif %}
      {% endfor %}
    </div>
    <p class="empty" style="margin-top:10px">灰色为已识别但暂不可跳转（如知识库目标尚未接入）。</p>
  </section>
  {% endif %}

  <section id="appendix">
    <h2>附录 A · 活动块原始记录 <span class="sub">{{ blocks | length }} 块</span></h2>
    <table>
      <thead><tr><th style="width:78px">时间</th><th style="width:52px">分钟</th><th style="width:110px">应用</th><th>标题 / 文字摘录</th><th style="width:140px">截图</th></tr></thead>
      <tbody>
      {% for b in blocks %}
        <tr id="{{ b.id }}">
          <td class="mono">{{ b.start[11:16] }}–{{ b.end[11:16] }}<div style="font-size:10px;color:#9ca3af">{{ b.id }}</div></td>
          <td class="mono">{{ b.minutes }}</td>
          <td>{{ b.app or '-' }}<div style="font-size:11px;color:#9ca3af">{{ b._cat_label }}</div></td>
          <td>
            <div>{{ b.title or '(无标题)' }}</div>
            {% if b.text %}
            <details><summary>展开文字摘录（{{ b.text | length }} 字）</summary><pre>{{ b.text }}</pre></details>
            {% endif %}
          </td>
          <td>{% if b._thumb %}<img class="thumb" src="{{ b._thumb }}" data-img="{{ b._full }}" loading="lazy" alt="">{% else %}<span class="empty">—</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section>
    <h2>附录 B · 生成信息</h2>
    <table>
      <tbody>
        <tr><th style="width:140px">生成时间</th><td class="mono">{{ d.generated_at }}</td></tr>
        <tr><th>触发原因</th><td>{{ {'auto':'每日 21:00 自动','manual':'手动','catchup':'开机补跑','finalize':'次日终版'}.get(d.reason, d.reason) }}</td></tr>
        <tr><th>模型</th><td class="mono">{{ d.meta.model or '未调用' }}（调用 {{ d.meta.calls }} 次，输入 {{ d.meta.prompt_tokens }} / 输出 {{ d.meta.completion_tokens }} tokens）</td></tr>
        <tr><th>输入规模</th><td>{{ d.meta.payload_chars }} 字（预算 {{ d.meta.payload_budget }}），详写 {{ d.meta.blocks_detailed }} / {{ d.meta.blocks_total }} 块</td></tr>
        <tr><th>耗时</th><td>{{ d.meta.elapsed_ms }} ms</td></tr>
        {% if d.meta.issues %}
        <tr><th>校验提示</th><td>{% for i in d.meta.issues %}<div>· {{ i }}</div>{% endfor %}</td></tr>
        {% endif %}
      </tbody>
    </table>
  </section>

  <footer>What-I-Did · 截图与 OCR 全部在本机完成，仅文本摘要发送给模型</footer>
</div>

<div id="lightbox"><img id="lightbox-img" alt=""></div>
<script>
(function () {
  var lb = document.getElementById('lightbox');
  var lbi = document.getElementById('lightbox-img');
  document.addEventListener('click', function (e) {
    var t = e.target.closest('[data-img]');
    if (t) { lbi.src = t.getAttribute('data-img'); lb.classList.add('on'); e.preventDefault(); return; }
    if (e.target === lb || e.target === lbi) { lb.classList.remove('on'); lbi.src = ''; }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') lb.classList.remove('on'); });

  var s = document.getElementById('tl-search');
  if (s) {
    s.addEventListener('input', function () {
      var q = s.value.trim().toLowerCase();
      document.querySelectorAll('#tl-list li').forEach(function (li) {
        var txt = li.getAttribute('data-text') || li.textContent.toLowerCase();
        li.style.display = (!q || txt.indexOf(q) >= 0) ? '' : 'none';
      });
    });
  }
})();
</script>
</body>
</html>
