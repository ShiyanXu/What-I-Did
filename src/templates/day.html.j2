<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t("{day} daily report · What-I-Did", day=day) }}</title>
{% include "_style.html.j2" %}
</head>
<body>
<div class="wrap">

  <a class="back" href="../index.html">← {{ t("Back to dashboard") }}</a>

  <header class="hero">
    <div class="hero-top">
      <h1>{{ day }}<span class="wd">{{ weekday }}</span></h1>
      <div class="badges">
        {% if d.status == 'ok' %}<span class="badge ok">{{ t("Model-generated") }}</span>
        {% elif d.status == 'degraded' %}<span class="badge warn">{{ t("Degraded · timeline only") }}</span>
        {% else %}<span class="badge mute">{{ t("Empty day") }}</span>{% endif %}
        <span class="badge">{{ {'auto': t("Auto at 21:00"), 'manual': t("Manual"), 'catchup': t("Catch-up on boot"), 'finalize': t("Final, next day")}.get(d.reason, d.reason) }}</span>
        <span class="badge">{{ d.coverage.note or d.coverage.window }}</span>
        <span class="badge">{{ t("Revision {n}", n=d.revision) }}</span>
        {% if d.report.confidence %}<span class="badge">{{ t("Confidence {level}", level=d.report.confidence) }}</span>{% endif %}
      </div>
    </div>
    <p class="headline">{{ d.report.headline or t("(untitled)") }}</p>
  </header>

  <div class="cards{% if rv.metrics | length == 4 %} four{% endif %}">
    {% for m in rv.metrics %}
    <div class="card"><div class="n">{{ m.n }}<small>{{ m.unit }}</small></div><div class="k">{{ m.k }}</div></div>
    {% endfor %}
  </div>

  {% if rv.cards %}
  <section id="outcomes">
    <h2>{{ t("Outcomes today") }} <span class="sub">{{ tn(rv.cards | length, "{n} item · every one traceable", "{n} items · every one traceable") }}</span></h2>
    <div class="outcome-list">
      {% for c in rv.cards %}
      <article class="outcome o-{{ c.status_cls }}">
        <div class="o-head">
          <span class="st {{ c.status_cls }}">{{ c.status_label }}</span>
          <div class="o-what">{{ c.what }}</div>
        </div>
        <div class="o-body">
          {% if c.impact %}<p class="o-line"><b>{{ t("Significance") }}</b>{{ c.impact }}</p>{% endif %}
          {% if c.next %}<p class="o-line next"><b>{{ t("Next") }}</b>{{ c.next }}</p>{% endif %}
        </div>
        {% if c.evidence or c.docs or c.shot or c.block_ids %}
        <details class="ev-box">
          <summary>{{ t("Evidence") }}{% if c.evidence %} · {{ t("excerpt") }}{% endif %}{% if c.shot %} · {{ t("screenshot") }}{% endif %}{% if c.docs %} · {{ tn(c.docs | length, "{n} document", "{n} documents") }}{% endif %}</summary>
          {% if c.evidence %}<div class="ev-quote">{{ c.evidence }}</div>{% endif %}
          {% if c.shot %}
          <div class="ev-shot">
            <img class="thumb" src="{{ c.shot.thumb }}" data-img="{{ c.shot.full }}" loading="lazy" alt="">
            <div class="ev-cap">{{ c.shot.caption }}</div>
          </div>
          {% endif %}
          {% if c.docs %}
          <div class="chips">
            {% for r in c.docs %}
              {% if r.clickable %}<a class="refchip {{ r.kind }}" href="{{ r.uri }}" target="_blank" title="{{ r.uri }}">📄 {{ r.label }}</a>
              {% else %}<span class="refchip off" title="{{ r.uri }}">{{ r.label }}</span>{% endif %}
            {% endfor %}
          </div>
          {% endif %}
          {% if c.block_ids %}
          <div class="chips">{% for bid in c.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
          {% endif %}
        </details>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if rv.todos %}
  <section id="todos">
    <h2>{{ t("Open items & blockers") }} <span class="sub">{{ tn(rv.todos | length, "{n} thing to move next", "{n} things to move next") }}</span></h2>
    <ul class="todo-list">
      {% for item in rv.todos %}
      <li>
        <span class="st {{ {'waiting':'wait','blocked':'blk','todo':'todo'}.get(item.kind, 'todo') }}">{{ {'waiting': t("Waiting on others"), 'blocked': t("Blocked"), 'todo': t("To do")}.get(item.kind, t("To do")) }}</span>
        <div class="todo-body">
          <div class="todo-item">{{ item.item }}</div>
          {% if item.why %}<div class="todo-why">{{ item.why }}</div>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if rv.tasks %}
  <section id="mainline">
    <h2>{{ t("Main threads") }} <span class="sub">{{ t("{n} threads", n=rv.task_notes.tasks) }} · {{ tn(rv.task_notes.segments, "merged from {n} work segment", "merged from {n} work segments") }}</span></h2>
    <div class="daystrip tall">
      {% for s in rv.task_segs %}
      <span class="seg" style="left:{{ s.left }}%;width:{{ s.width }}%;background:{{ s.color }}" title="{{ s.title }}"></span>
      {% endfor %}
    </div>
    <div class="ticks">{% for tick in ticks %}<span>{{ tick }}</span>{% endfor %}</div>
    <table class="lanes">
      <thead><tr><th style="width:118px">{{ t("Time") }}</th><th>{{ t("What was happening") }}</th><th style="width:38%">{{ t("Outcome") }}</th></tr></thead>
      <tbody>
        {% for task in rv.tasks %}
        <tr>
          <td class="mono">{{ task.start }}–{{ task.end }}<div class="lane-dur">{{ t("{n} min", n=task.minutes) }}</div></td>
          <td>
            <div class="lane-label"><span class="vdot" style="background:{{ (verbs.get(task.verb) or {}).get('color', '#94a3b8') }}"></span>{{ task.label }}</div>
            {% if task.detail %}<div class="lane-detail">{{ task.detail }}</div>{% endif %}
          </td>
          <td>
            {% if task.outcome %}<span class="lane-out">{{ task.outcome }}</span>
            {% else %}<span class="empty">—</span>{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if rv.task_notes.merged or rv.task_notes.away %}
    <p class="empty lane-note">
      {% if rv.task_notes.merged %}{{ tn(rv.task_notes.merged, "{n} short switch was folded into its thread; the appendix lists every segment.", "{n} short switches were folded into their threads; the appendix lists every segment.") }}{% endif %}
      {% if rv.task_notes.away %}{{ tn(rv.task_notes.away, "{n} locked or away segment is not counted in the threads.", "{n} locked or away segments are not counted in the threads.") }}{% endif %}
    </p>
    {% endif %}
  </section>
  {% endif %}

  {% if d.report.offline %}
  <section>
    <h2>{{ t("Manual entries") }} <span class="sub">{{ t("Work the screen cannot see: meetings, time away, thinking. Entered by you, not counted as screen activity.") }}</span></h2>
    <ul class="tl">
      {% for o in d.report.offline %}
      <li>
        <div class="t">{{ o.start }}–{{ o.end }}</div>
        <div class="body">
          <div class="title">{{ o.label }}</div>
          {% if o.note %}<div class="impact">{{ o.note }}</div>{% endif %}
          <div class="chips"><span class="chip">{{ t("Manual entry") }}</span></div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section id="time">
    <h2>{{ t("Time split") }} <span class="sub">{{ t("Where the time went, not what it produced") }}</span></h2>
    <div class="legend">
      {% for key, label in cat_label.items() %}
      {% if key in d.stats.by_category %}
      <span><i style="background:{{ {'dev':'#2563eb','doc':'#0d9488','meet':'#d97706','comm':'#7c3aed','web':'#64748b','other':'#94a3b8'}[key] }}"></i>{{ label }} {{ t("{n} min", n=d.stats.by_category[key]) }}</span>
      {% endif %}
      {% endfor %}
      <span>{{ t("Active {h} h", h=(d.stats.active_minutes / 60) | round(1)) }}{% if d.stats.idle_minutes %}{{ t(" (plus {n} min paused or locked, not counted)", n=d.stats.idle_minutes) }}{% endif %}</span>
    </div>
    {% if rhythm.longest_focus_min %}
    <div class="rhythm">
      <span>{{ t("Longest focus") }} <b>{{ t("{n} min", n=rhythm.longest_focus_min) }}</b> {{ t("({at})", at=rhythm.longest_focus_at) }}</span>
      <span>{{ t("Interruptions") }} <b>{{ rhythm.interruptions }}</b></span>
      <span>{{ t("Fragmented time") }} <b>{{ t("{n} min", n=rhythm.fragmented_min) }}</b> {{ t("({pct}%)", pct=(rhythm.fragmented_ratio * 100) | round(0) | int) }}</span>
      <span>{{ t("Deep work") }} <b>{{ t("{n} min", n=rhythm.deep_work_min) }}</b></span>
      <span>{{ t("Busiest window") }} <b>{{ rhythm.peak_window }}</b></span>
    </div>
    {% endif %}
    {% if rv.gaps.inside %}
    <div class="callout info gap-line">
      {{ t("Recording gaps between {from} and {to}:", from=rv.gaps.first, to=rv.gaps.last) }}{% for g in rv.gaps.inside %}<b>{{ g.start }}–{{ g.end }}</b> ({{ t("{n} min", n=g.minutes) }}){% if not loop.last %}{{ t(", ") }}{% endif %}{% endfor %}{{ t(". Mostly time away, a meeting or a break; not counted in the durations above.") }}
    </div>
    {% endif %}
  </section>

  {% set ins = d.report.insight %}
  {% if ins %}
  <section>
    <h2>{{ t("Two more observations") }} <span class="sub">{{ t("A judgement about how the work went, not a recap") }}</span></h2>
    <div class="grid2">
      {% for it in ins %}
      <div class="item">
        <div class="what">{{ it.observation }}</div>
        {% if it.evidence %}<div class="impact"><b>{{ t("Basis") }}</b>　{{ it.evidence }}</div>{% endif %}
        {% if it.action %}<div class="impact"><b>{{ t("Next time") }}</b>　{{ it.action }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% set fr = d.report.friction %}
  {% if fr %}
  <section>
    <h2>{{ t("Blockers & cost") }} <span class="sub">{{ t("What it cost in time and detours, also recorded") }}</span></h2>
    <ul class="tl">
      {% for it in fr %}
      <li>
        <div class="t">{{ t("Blocker {n}", n=loop.index) }}</div>
        <div class="body">
          <div class="title">{{ it.what }}</div>
          {% if it.cause %}<div class="impact"><b>{{ t("Cause") }}</b>　{{ it.cause }}</div>{% endif %}
          {% if it.cost %}<div class="impact"><b>{{ t("Cost") }}</b>　{{ it.cost }}</div>{% endif %}
          {% if it.fix %}<div class="impact"><b>{{ t("Handling") }}</b>　{{ it.fix }}</div>{% endif %}
          <div class="chips">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if d.report.decisions or d.report.learnings or d.report.in_progress or d.report.blockers %}
  <section>
    <h2>{{ t("Additional notes") }}</h2>
    <div class="grid2">
      {% if d.report.in_progress %}
      <div>
        <h3>{{ t("In progress") }}</h3>
        {% for it in d.report.in_progress %}
        <div class="item" style="margin-bottom:10px">
          <div class="what">{{ it.what }}</div>
          {% if it.state %}<div class="impact">{{ it.state }}</div>{% endif %}
          {% if it.next %}<div class="impact"><b>{{ t("Next:") }}</b>{{ it.next }}</div>{% endif %}
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if d.report.blockers %}
      <div>
        <h3>{{ t("Other blockers") }}</h3>
        {% for it in d.report.blockers %}
        <div class="item" style="margin-bottom:10px">
          <div class="what">{{ it.what }}</div>
          {% if it.detail %}<div class="impact mono">{{ it.detail }}</div>{% endif %}
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if d.report.decisions %}
      <div>
        <h3>{{ t("Decisions") }}</h3>
        {% for it in d.report.decisions %}
        <div class="item" style="margin-bottom:10px"><div class="what">{{ it.what }}</div>
          {% if it.why %}<div class="impact">{{ it.why }}</div>{% endif %}
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if d.report.learnings %}
      <div>
        <h3>{{ t("Learnings") }}</h3>
        {% for it in d.report.learnings %}
        <div class="item" style="margin-bottom:10px"><div class="what">{{ it.what }}</div>
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if rv.tomorrow_extra %}
  <section>
    <h2>{{ t("Tomorrow") }} <span class="sub">{{ t("How today's leftovers continue") }}</span></h2>
    <ul class="tl">
      {% for it in rv.tomorrow_extra %}
      <li style="grid-template-columns:26px 1fr">
        <div class="t">☐</div>
        <div class="body"><div class="title">{{ it.item }}</div>{% if it.why %}<div class="impact">{{ it.why }}</div>{% endif %}{% if it.when %}<div class="chips"><span class="chip">{{ it.when }}</span></div>{% endif %}</div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% set tb = d.report.time_breakdown %}
  {% if tb %}
  {% set maxmin = (tb | map(attribute='minutes') | max) or 1 %}
  <section>
    <h2>{{ t("Estimated time split") }} <span class="sub">{{ t("Model estimate, reference only") }}</span></h2>
    <div class="bars">
      {% for it in tb %}
      <div class="bar"><span>{{ it.category }}</span>
        <span class="track"><span class="fill" style="width:{{ (it.minutes / maxmin * 100) | round(1) }}%"></span></span>
        <span class="v">{{ t("{n} min", n=it.minutes) }}</span></div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- ============================ 证据与附录：默认折叠 ============================ -->

  <section id="appendix">
    <h2>{{ t("Evidence & appendix") }} <span class="sub">{{ t("Open these only to check a conclusion; day-to-day reading stops above") }}</span></h2>

    <details class="appx" id="appendix-blocks">
      <summary>{{ t("Activity blocks · {count} (split by app, with screenshots and text excerpts)", count=tn(blocks | length, "{n} block", "{n} blocks")) }}</summary>
      <div class="appx-body">
        <input class="search" id="tl-search" placeholder="{{ t('Filter… (file, app or window title)') }}">
        <table>
          <thead><tr><th style="width:92px">{{ t("Time") }}</th><th style="width:52px">{{ t("Min") }}</th><th style="width:110px">{{ t("App") }}</th><th>{{ t("Title / text excerpt") }}</th><th style="width:120px">{{ t("Screenshot") }}</th></tr></thead>
          <tbody id="tl-list">
          {% for b in blocks %}
            <tr id="{{ b.id }}" data-text="{{ (b.title ~ ' ' ~ b.app) | lower }}">
              <td class="mono">{{ b.start[11:16] }}–{{ b.end[11:16] }}<div class="tiny">{{ b.id }}</div></td>
              <td class="mono">{{ b.minutes }}</td>
              <td>{{ b.app or '-' }}<div class="tiny">{{ b._cat_label }}</div></td>
              <td>
                <div>{{ b.title or t("(untitled)") }}</div>
                {% if b.text %}
                <details><summary>{{ t("Show text excerpt ({n} chars)", n=b.text | length) }}</summary><pre>{{ b.text }}</pre></details>
                {% endif %}
              </td>
              <td>{% if b._thumb %}<img class="thumb" src="{{ b._thumb }}" data-img="{{ b._full }}" loading="lazy" alt="">{% else %}<span class="empty">—</span>{% endif %}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
        {% if not blocks %}<p class="empty">{{ t("No activity blocks recorded.") }}</p>{% endif %}
      </div>
    </details>

    {% if segs or bsegs %}
    <details class="appx">
      <summary>{{ t("Raw strip · every block colored separately ({blocks} / {segments})", blocks=tn(blocks | length, "{n} block", "{n} blocks"), segments=tn(behaviors | length, "{n} work segment", "{n} work segments")) }}</summary>
      <div class="appx-body">
        <div class="daystrip tall">
          {% for s in segs %}
          <a class="seg" href="#{{ s.id }}" style="left:{{ s.left }}%;width:{{ s.width }}%;background:{{ s.color }}" title="{{ s.title }}"></a>
          {% endfor %}
        </div>
        <div class="ticks">{% for tick in ticks %}<span>{{ tick }}</span>{% endfor %}</div>
        {% if behaviors %}
        <div class="legend" style="margin-top:12px"><span>{{ t("Split into {n} work segments, each described below:", n=d.report.behaviors | length) }}</span></div>
        <ul class="tl" style="margin-top:6px">
          {% for it in behaviors %}
          <li>
            <div class="t">{{ it.start }}–{{ it.end }}<div class="dur">{{ t("{n} min", n=it.minutes) }}</div></div>
            <div class="body">
              <div class="title"><span class="vdot" style="background:{{ (verbs.get(it.verb) or {}).get('color', '#94a3b8') }}"></span>{{ it.label }}{% if it.confidence == 'low' %}<span class="q">?</span>{% endif %}</div>
              {% if it.detail %}<div class="impact">{{ it.detail }}</div>{% endif %}
              <div class="chips">
                <span class="chip">{{ (verbs.get(it.verb) or {}).get('label', it.verb) }}</span>
                {% if it.switches %}<span class="chip">{{ tn(it.switches, "Switched {n} time", "Switched {n} times") }}</span>{% endif %}
              </div>
            </div>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </details>
    {% endif %}

    {% if refs_list %}
    <details class="appx">
      <summary>{{ t("Related documents · {n} (only those that back a conclusion appear in the body)", n=refs_list | length) }}</summary>
      <div class="appx-body">
        <div class="chips">
          {% for r in refs_list %}
            {% if r.clickable %}
            <a class="refchip {{ r.kind }}" href="{{ r.uri }}" target="_blank" title="{{ r.why }} · {{ r.uri }}">{{ r.label }}{% if r.source == "domain" %}<span class="domain-only">{{ t("(domain only)") }}</span>{% endif %}</a>
            {% else %}
            <span class="refchip off" title="{{ r.uri }}">{{ r.label }}</span>
            {% endif %}
          {% endfor %}
        </div>
        <p class="empty" style="margin-top:10px">{{ t("Grey chips are recognized but not clickable yet (the knowledge base target is not wired up). This build only links; it never modifies an external document.") }}</p>
      </div>
    </details>
    {% endif %}

    {% if d.report.opening_md or d.report.summary_md %}
    <details class="appx">
      <summary>{{ t("Full narrative · {part} (kept verbatim, for a full read when needed)", part=(t("Opening and process") if d.report.opening_md else t("Process"))) }}</summary>
      <div class="appx-body prose">
        {% if d.report.opening_md %}
        {% for para in d.report.opening_md.split('\n\n') if para.strip() %}<p>{{ para | replace('\n', ' ') }}</p>{% endfor %}
        {% endif %}
        {% if d.report.summary_md %}
        {% for para in d.report.summary_md.split('\n\n') if para.strip() %}<p>{{ para | replace('\n', ' ') }}</p>{% endfor %}
        {% else %}
        <p class="empty">{{ d.report.notes_for_human or t("No narrative summary was generated for this day.") }}</p>
        {% endif %}
      </div>
    </details>
    {% endif %}

    <details class="appx">
      <summary>{{ t("Data gaps & generation details") }}</summary>
      <div class="appx-body">
        {% if d.gaps %}
        <div class="callout">
          {{ t("Spans with no capture inside the whole window ({window}), night and normal breaks included; listed here for completeness:", window=d.coverage.window) }}
          {% for g in d.gaps %}<b>{{ g.start }}–{{ g.end }}</b> ({{ t("{n} min", n=g.minutes) }}){% if not loop.last %}{{ t(", ") }}{% endif %}{% endfor %}
        </div>
        {% endif %}
        <table style="margin-top:12px">
          <tbody>
            <tr><th style="width:140px">{{ t("Window") }}</th><td class="mono">{{ d.coverage.window or t("04:00 – 04:00 next day") }}{% if d.coverage.until %} · {{ t("until {time}", time=d.coverage.until) }}{% endif %}</td></tr>
            <tr><th>{{ t("First & last record") }}</th><td class="mono">{{ d.stats.first or '—' }} → {{ d.stats.last or '—' }}</td></tr>
            <tr><th>{{ t("Capture volume") }}</th><td>{{ tn(d.stats.block_count, "{n} activity block", "{n} activity blocks") }} · {{ tn(d.stats.shot_count, "{n} screenshot", "{n} screenshots") }} · {{ tn(d.stats.ocr_blocks, "{n} block with OCR text", "{n} blocks with OCR text") }} · {{ tn(d.refs | length, "{n} document reference", "{n} document references") }} · {{ tn(rhythm.session_count or 0, "{n} work segment", "{n} work segments") }}</td></tr>
            <tr><th>{{ t("Generated at") }}</th><td class="mono">{{ d.generated_at }}</td></tr>
            <tr><th>{{ t("Trigger") }}</th><td>{{ {'auto': t("Daily at 21:00"), 'manual': t("Manual"), 'catchup': t("Catch-up on boot"), 'finalize': t("Final, next day")}.get(d.reason, d.reason) }}</td></tr>
            <tr><th>{{ t("Model") }}</th><td class="mono">{{ d.meta.model or t("not called") }} {{ t("({calls} calls, {prompt} in / {completion} out tokens)", calls=d.meta.calls, prompt=d.meta.prompt_tokens, completion=d.meta.completion_tokens) }}</td></tr>
            <tr><th>{{ t("Input size") }}</th><td>{{ t("{chars} chars (budget {budget}), {detailed} of {total} blocks detailed in full", chars=d.meta.payload_chars, budget=d.meta.payload_budget, detailed=d.meta.blocks_detailed, total=d.meta.blocks_total) }}</td></tr>
            <tr><th>{{ t("Elapsed") }}</th><td>{{ d.meta.elapsed_ms }} ms</td></tr>
            {% if d.report.notes_for_human %}
            <tr><th>{{ t("Uncertainties") }}</th><td>{{ d.report.notes_for_human }}</td></tr>
            {% endif %}
            {% if d.meta.issues %}
            <tr><th>{{ t("Validation notes") }}</th><td>{% for i in d.meta.issues %}<div>· {{ i }}</div>{% endfor %}</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <footer>What-I-Did · {{ t("Screenshots and OCR run on this machine; only text summaries go to the model") }}</footer>
</div>

<div id="lightbox"><img id="lightbox-img" alt=""></div>
<script>
(function () {
  var lb = document.getElementById('lightbox');
  var lbi = document.getElementById('lightbox-img');
  document.addEventListener('click', function (e) {
    var t = e.target.closest('[data-img]');
    if (t) { lbi.src = t.getAttribute('data-img'); lb.classList.add('on'); e.preventDefault(); return; }
    if (e.target === lb || e.target === lbi) { lb.classList.remove('on'); lbi.src = ''; }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') lb.classList.remove('on'); });

  var s = document.getElementById('tl-search');
  if (s) {
    s.addEventListener('input', function () {
      var q = s.value.trim().toLowerCase();
      document.querySelectorAll('#tl-list tr').forEach(function (tr) {
        var txt = tr.getAttribute('data-text') || tr.textContent.toLowerCase();
        tr.style.display = (!q || txt.indexOf(q) >= 0) ? '' : 'none';
      });
    });
  }
  // 从正文点证据编号跳到折叠附录时，先把对应折叠块展开
  document.addEventListener('click', function (e) {
    var a = e.target.closest('a.ev');
    if (!a) return;
    var target = document.getElementById((a.getAttribute('href') || '').slice(1));
    if (!target) return;
    var box = target.closest('details');
    while (box) { box.open = true; box = box.parentElement && box.parentElement.closest('details'); }
    setTimeout(function () { target.scrollIntoView({ block: 'center', behavior: 'smooth' }); }, 30);
    e.preventDefault();
  });
})();
</script>
</body>
</html>
