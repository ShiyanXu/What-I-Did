<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ day }} 工作日报 · What-I-Did</title>
{% include "_style.html.j2" %}
</head>
<body>
<div class="wrap">

  <a class="back" href="../index.html">← 返回看板</a>

  <header class="hero">
    <div class="hero-top">
      <h1>{{ day }}<span class="wd">{{ weekday }}</span></h1>
      <div class="badges">
        {% if d.status == 'ok' %}<span class="badge ok">模型生成</span>
        {% elif d.status == 'degraded' %}<span class="badge warn">降级 · 仅时间线</span>
        {% else %}<span class="badge mute">空日</span>{% endif %}
        <span class="badge">{{ {'auto':'21:00 自动','manual':'手动生成','catchup':'开机补跑','finalize':'次日终版'}.get(d.reason, d.reason) }}</span>
        <span class="badge">{{ d.coverage.note or d.coverage.window }}</span>
        <span class="badge">第 {{ d.revision }} 版</span>
        {% if d.report.confidence %}<span class="badge">置信度 {{ d.report.confidence }}</span>{% endif %}
      </div>
    </div>
    <p class="headline">{{ d.report.headline or '（无标题）' }}</p>
  </header>

  <div class="cards{% if rv.metrics | length == 4 %} four{% endif %}">
    {% for m in rv.metrics %}
    <div class="card"><div class="n">{{ m.n }}<small>{{ m.unit }}</small></div><div class="k">{{ m.k }}</div></div>
    {% endfor %}
  </div>

  {% if rv.cards %}
  <section id="outcomes">
    <h2>今日成果 <span class="sub">{{ rv.cards | length }} 项 · 每条都能追到原始记录</span></h2>
    <div class="outcome-list">
      {% for c in rv.cards %}
      <article class="outcome o-{{ c.status_cls }}">
        <div class="o-head">
          <span class="st {{ c.status_cls }}">{{ c.status_label }}</span>
          <div class="o-what">{{ c.what }}</div>
        </div>
        <div class="o-body">
          {% if c.impact %}<p class="o-line"><b>意义</b>{{ c.impact }}</p>{% endif %}
          {% if c.next %}<p class="o-line next"><b>下一步</b>{{ c.next }}</p>{% endif %}
        </div>
        {% if c.evidence or c.docs or c.shot or c.block_ids %}
        <details class="ev-box">
          <summary>证据{% if c.evidence %} · 摘录{% endif %}{% if c.shot %} · 截图{% endif %}{% if c.docs %} · 文档 {{ c.docs | length }}{% endif %}</summary>
          {% if c.evidence %}<div class="ev-quote">{{ c.evidence }}</div>{% endif %}
          {% if c.shot %}
          <div class="ev-shot">
            <img class="thumb" src="{{ c.shot.thumb }}" data-img="{{ c.shot.full }}" loading="lazy" alt="">
            <div class="ev-cap">{{ c.shot.caption }}</div>
          </div>
          {% endif %}
          {% if c.docs %}
          <div class="chips">
            {% for r in c.docs %}
              {% if r.clickable %}<a class="refchip {{ r.kind }}" href="{{ r.uri }}" target="_blank" title="{{ r.uri }}">📄 {{ r.label }}</a>
              {% else %}<span class="refchip off" title="{{ r.uri }}">{{ r.label }}</span>{% endif %}
            {% endfor %}
          </div>
          {% endif %}
          {% if c.block_ids %}
          <div class="chips">{% for bid in c.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
          {% endif %}
        </details>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if rv.todos %}
  <section id="todos">
    <h2>待办与卡点 <span class="sub">接下来要动的 {{ rv.todos | length }} 件事</span></h2>
    <ul class="todo-list">
      {% for t in rv.todos %}
      <li>
        <span class="st {{ {'waiting':'wait','blocked':'blk','todo':'todo'}.get(t.kind, 'todo') }}">{{ {'waiting':'待外部','blocked':'卡点','todo':'待办'}.get(t.kind, '待办') }}</span>
        <div class="todo-body">
          <div class="todo-item">{{ t.item }}</div>
          {% if t.why %}<div class="todo-why">{{ t.why }}</div>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if rv.tasks %}
  <section id="mainline">
    <h2>工作主线 <span class="sub">{{ rv.task_notes.tasks }} 段 · 由 {{ rv.task_notes.segments }} 个连续工作段按主线合并</span></h2>
    <div class="daystrip tall">
      {% for s in rv.task_segs %}
      <span class="seg" style="left:{{ s.left }}%;width:{{ s.width }}%;background:{{ s.color }}" title="{{ s.title }}"></span>
      {% endfor %}
    </div>
    <div class="ticks">{% for t in ticks %}<span>{{ t }}</span>{% endfor %}</div>
    <table class="lanes">
      <thead><tr><th style="width:118px">时间</th><th>在做什么</th><th style="width:38%">这段的结果</th></tr></thead>
      <tbody>
        {% for t in rv.tasks %}
        <tr>
          <td class="mono">{{ t.start }}–{{ t.end }}<div class="lane-dur">{{ t.minutes }} 分</div></td>
          <td>
            <div class="lane-label"><span class="vdot" style="background:{{ (verbs.get(t.verb) or {}).get('color', '#94a3b8') }}"></span>{{ t.label }}</div>
            {% if t.detail %}<div class="lane-detail">{{ t.detail }}</div>{% endif %}
          </td>
          <td>
            {% if t.outcome %}<span class="lane-out">{{ t.outcome }}</span>
            {% else %}<span class="empty">—</span>{% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if rv.task_notes.merged or rv.task_notes.away %}
    <p class="empty lane-note">
      {% if rv.task_notes.merged %}已把 {{ rv.task_notes.merged }} 个短切换并入所属主线，逐段明细见附录。{% endif %}
      {% if rv.task_notes.away %}另有 {{ rv.task_notes.away }} 段锁屏/离开未计入主线。{% endif %}
    </p>
    {% endif %}
  </section>
  {% endif %}

  {% if d.report.offline %}
  <section>
    <h2>人工补录 <span class="sub">屏幕看不到的工作：会议、外出、思考。由本人登记，不计入屏幕活动统计</span></h2>
    <ul class="tl">
      {% for o in d.report.offline %}
      <li>
        <div class="t">{{ o.start }}–{{ o.end }}</div>
        <div class="body">
          <div class="title">{{ o.label }}</div>
          {% if o.note %}<div class="impact">{{ o.note }}</div>{% endif %}
          <div class="chips"><span class="chip">人工登记</span></div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section id="time">
    <h2>时间分配 <span class="sub">这部分说明时间花在哪，不是成果本身</span></h2>
    <div class="legend">
      {% for key, label in cat_label.items() %}
      {% if key in d.stats.by_category %}
      <span><i style="background:{{ {'dev':'#2563eb','doc':'#0d9488','meet':'#d97706','comm':'#7c3aed','web':'#64748b','other':'#94a3b8'}[key] }}"></i>{{ label }} {{ d.stats.by_category[key] }} 分</span>
      {% endif %}
      {% endfor %}
      <span>有效活动 {{ (d.stats.active_minutes / 60) | round(1) }} 小时{% if d.stats.idle_minutes %}（另有 {{ d.stats.idle_minutes }} 分暂停/锁屏，未计入）{% endif %}</span>
    </div>
    {% if rhythm.longest_focus_min %}
    <div class="rhythm">
      <span>最长专注 <b>{{ rhythm.longest_focus_min }} 分</b>（{{ rhythm.longest_focus_at }}）</span>
      <span>被打断 <b>{{ rhythm.interruptions }}</b> 次</span>
      <span>碎片段 <b>{{ rhythm.fragmented_min }} 分</b>（{{ (rhythm.fragmented_ratio * 100) | round(0) | int }}%）</span>
      <span>整段工作 <b>{{ rhythm.deep_work_min }} 分</b></span>
      <span>活动最密 <b>{{ rhythm.peak_window }}</b></span>
    </div>
    {% endif %}
    {% if rv.gaps.inside %}
    <div class="callout info gap-line">
      记录中断（{{ rv.gaps.first }}–{{ rv.gaps.last }} 之间）：{% for g in rv.gaps.inside %}<b>{{ g.start }}–{{ g.end }}</b>（{{ g.minutes }} 分）{% if not loop.last %}、{% endif %}{% endfor %}。多半是离开、会议或休息，这些时间不算进上面的时长。
    </div>
    {% endif %}
  </section>

  {% set ins = d.report.insight %}
  {% if ins %}
  <section>
    <h2>另外两点观察 <span class="sub">对工作方式的判断，不是复述</span></h2>
    <div class="grid2">
      {% for it in ins %}
      <div class="item">
        <div class="what">{{ it.observation }}</div>
        {% if it.evidence %}<div class="impact"><b>依据</b>　{{ it.evidence }}</div>{% endif %}
        {% if it.action %}<div class="impact"><b>下次</b>　{{ it.action }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% set fr = d.report.friction %}
  {% if fr %}
  <section>
    <h2>卡点与代价 <span class="sub">花了多少时间、绕了多少路，也记下来</span></h2>
    <ul class="tl">
      {% for it in fr %}
      <li>
        <div class="t">卡点 {{ loop.index }}</div>
        <div class="body">
          <div class="title">{{ it.what }}</div>
          {% if it.cause %}<div class="impact"><b>原因</b>　{{ it.cause }}</div>{% endif %}
          {% if it.cost %}<div class="impact"><b>代价</b>　{{ it.cost }}</div>{% endif %}
          {% if it.fix %}<div class="impact"><b>处理</b>　{{ it.fix }}</div>{% endif %}
          <div class="chips">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if d.report.decisions or d.report.learnings or d.report.in_progress or d.report.blockers %}
  <section>
    <h2>补充记录</h2>
    <div class="grid2">
      {% if d.report.in_progress %}
      <div>
        <h3>进行中</h3>
        {% for it in d.report.in_progress %}
        <div class="item" style="margin-bottom:10px">
          <div class="what">{{ it.what }}</div>
          {% if it.state %}<div class="impact">{{ it.state }}</div>{% endif %}
          {% if it.next %}<div class="impact"><b>下一步：</b>{{ it.next }}</div>{% endif %}
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if d.report.blockers %}
      <div>
        <h3>其他卡点</h3>
        {% for it in d.report.blockers %}
        <div class="item" style="margin-bottom:10px">
          <div class="what">{{ it.what }}</div>
          {% if it.detail %}<div class="impact mono">{{ it.detail }}</div>{% endif %}
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if d.report.decisions %}
      <div>
        <h3>决策</h3>
        {% for it in d.report.decisions %}
        <div class="item" style="margin-bottom:10px"><div class="what">{{ it.what }}</div>
          {% if it.why %}<div class="impact">{{ it.why }}</div>{% endif %}
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if d.report.learnings %}
      <div>
        <h3>收获</h3>
        {% for it in d.report.learnings %}
        <div class="item" style="margin-bottom:10px"><div class="what">{{ it.what }}</div>
          <div class="foot">{% for bid in it.block_ids %}<a class="ev" href="#{{ bid }}">{{ bid }}</a>{% endfor %}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if rv.tomorrow_extra %}
  <section>
    <h2>明天 <span class="sub">今天的遗留怎么接着做</span></h2>
    <ul class="tl">
      {% for it in rv.tomorrow_extra %}
      <li style="grid-template-columns:26px 1fr">
        <div class="t">☐</div>
        <div class="body"><div class="title">{{ it.item }}</div>{% if it.why %}<div class="impact">{{ it.why }}</div>{% endif %}{% if it.when %}<div class="chips"><span class="chip">{{ it.when }}</span></div>{% endif %}</div>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% set tb = d.report.time_breakdown %}
  {% if tb %}
  {% set maxmin = (tb | map(attribute='minutes') | max) or 1 %}
  <section>
    <h2>时间分布 <span class="sub">模型估计，仅供参照</span></h2>
    <div class="bars">
      {% for it in tb %}
      <div class="bar"><span>{{ it.category }}</span>
        <span class="track"><span class="fill" style="width:{{ (it.minutes / maxmin * 100) | round(1) }}%"></span></span>
        <span class="v">{{ it.minutes }} 分</span></div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <!-- ============================ 证据与附录：默认折叠 ============================ -->

  <section id="appendix">
    <h2>证据与附录 <span class="sub">要核对结论时再展开；日常阅读不需要翻到这里</span></h2>

    <details class="appx" id="appendix-blocks">
      <summary>活动块明细 · {{ blocks | length }} 块（按应用切分，含截图与文字摘录）</summary>
      <div class="appx-body">
        <input class="search" id="tl-search" placeholder="过滤…（输入文件名、应用名、标题）">
        <table>
          <thead><tr><th style="width:92px">时间</th><th style="width:52px">分钟</th><th style="width:110px">应用</th><th>标题 / 文字摘录</th><th style="width:120px">截图</th></tr></thead>
          <tbody id="tl-list">
          {% for b in blocks %}
            <tr id="{{ b.id }}" data-text="{{ (b.title ~ ' ' ~ b.app) | lower }}">
              <td class="mono">{{ b.start[11:16] }}–{{ b.end[11:16] }}<div class="tiny">{{ b.id }}</div></td>
              <td class="mono">{{ b.minutes }}</td>
              <td>{{ b.app or '-' }}<div class="tiny">{{ b._cat_label }}</div></td>
              <td>
                <div>{{ b.title or '(无标题)' }}</div>
                {% if b.text %}
                <details><summary>展开文字摘录（{{ b.text | length }} 字）</summary><pre>{{ b.text }}</pre></details>
                {% endif %}
              </td>
              <td>{% if b._thumb %}<img class="thumb" src="{{ b._thumb }}" data-img="{{ b._full }}" loading="lazy" alt="">{% else %}<span class="empty">—</span>{% endif %}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
        {% if not blocks %}<p class="empty">没有活动块记录。</p>{% endif %}
      </div>
    </details>

    {% if segs or bsegs %}
    <details class="appx">
      <summary>原始色带 · 每个活动块单独上色（{{ blocks | length }} 块 / {{ behaviors | length }} 个连续工作段）</summary>
      <div class="appx-body">
        <div class="daystrip tall">
          {% for s in segs %}
          <a class="seg" href="#{{ s.id }}" style="left:{{ s.left }}%;width:{{ s.width }}%;background:{{ s.color }}" title="{{ s.title }}"></a>
          {% endfor %}
        </div>
        <div class="ticks">{% for t in ticks %}<span>{{ t }}</span>{% endfor %}</div>
        {% if behaviors %}
        <div class="legend" style="margin-top:12px"><span>行为段被 <b>{{ d.report.behaviors | length }}</b> 个连续工作段切分，逐段说明：</span></div>
        <ul class="tl" style="margin-top:6px">
          {% for it in behaviors %}
          <li>
            <div class="t">{{ it.start }}–{{ it.end }}<div class="dur">{{ it.minutes }} 分</div></div>
            <div class="body">
              <div class="title"><span class="vdot" style="background:{{ (verbs.get(it.verb) or {}).get('color', '#94a3b8') }}"></span>{{ it.label }}{% if it.confidence == 'low' %}<span class="q">?</span>{% endif %}</div>
              {% if it.detail %}<div class="impact">{{ it.detail }}</div>{% endif %}
              <div class="chips">
                <span class="chip">{{ (verbs.get(it.verb) or {}).get('label', it.verb) }}</span>
                {% if it.switches %}<span class="chip">切换 {{ it.switches }} 次</span>{% endif %}
              </div>
            </div>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
    </details>
    {% endif %}

    {% if refs_list %}
    <details class="appx">
      <summary>相关文档 · {{ refs_list | length }} 条（正文只挂了能支撑结论的那些）</summary>
      <div class="appx-body">
        <div class="chips">
          {% for r in refs_list %}
            {% if r.clickable %}
            <a class="refchip {{ r.kind }}" href="{{ r.uri }}" target="_blank" title="{{ r.why }} · {{ r.uri }}">{{ r.label }}</a>
            {% else %}
            <span class="refchip off" title="{{ r.uri }}">{{ r.label }}</span>
            {% endif %}
          {% endfor %}
        </div>
        <p class="empty" style="margin-top:10px">灰色为已识别但暂不可跳转（如知识库目标尚未接入）。本期只做跳转，不改动任何外部文档。</p>
      </div>
    </details>
    {% endif %}

    {% if d.report.opening_md or d.report.summary_md %}
    <details class="appx">
      <summary>叙述全文 · {{ '开篇与过程' if d.report.opening_md else '过程' }}（原样保留，供需要时通读）</summary>
      <div class="appx-body prose">
        {% if d.report.opening_md %}
        {% for para in d.report.opening_md.split('\n\n') if para.strip() %}<p>{{ para | replace('\n', ' ') }}</p>{% endfor %}
        {% endif %}
        {% if d.report.summary_md %}
        {% for para in d.report.summary_md.split('\n\n') if para.strip() %}<p>{{ para | replace('\n', ' ') }}</p>{% endfor %}
        {% else %}
        <p class="empty">{{ d.report.notes_for_human or '这一天没有生成叙述性总结。' }}</p>
        {% endif %}
      </div>
    </details>
    {% endif %}

    <details class="appx">
      <summary>数据缺口与生成信息</summary>
      <div class="appx-body">
        {% if d.gaps %}
        <div class="callout">
          全窗口（{{ d.coverage.window }}）内没有任何采集记录的时段，含夜间与正常休息，这里只是完整列出：
          {% for g in d.gaps %}<b>{{ g.start }}–{{ g.end }}</b>（{{ g.minutes }} 分）{% if not loop.last %}、{% endif %}{% endfor %}
        </div>
        {% endif %}
        <table style="margin-top:12px">
          <tbody>
            <tr><th style="width:140px">窗口</th><td class="mono">{{ d.coverage.window or ('04:00 – 次日 04:00') }}{% if d.coverage.until %} · 截至 {{ d.coverage.until }}{% endif %}</td></tr>
            <tr><th>首末记录</th><td class="mono">{{ d.stats.first or '—' }} → {{ d.stats.last or '—' }}</td></tr>
            <tr><th>采集规模</th><td>{{ d.stats.block_count }} 个活动块 · {{ d.stats.shot_count }} 张截图 · {{ d.stats.ocr_blocks }} 块有文字识别 · {{ d.refs | length }} 条文档引用 · {{ rhythm.session_count or 0 }} 个连续工作段</td></tr>
            <tr><th>生成时间</th><td class="mono">{{ d.generated_at }}</td></tr>
            <tr><th>触发原因</th><td>{{ {'auto':'每日 21:00 自动','manual':'手动','catchup':'开机补跑','finalize':'次日终版'}.get(d.reason, d.reason) }}</td></tr>
            <tr><th>模型</th><td class="mono">{{ d.meta.model or '未调用' }}（调用 {{ d.meta.calls }} 次，输入 {{ d.meta.prompt_tokens }} / 输出 {{ d.meta.completion_tokens }} tokens）</td></tr>
            <tr><th>输入规模</th><td>{{ d.meta.payload_chars }} 字（预算 {{ d.meta.payload_budget }}），详写 {{ d.meta.blocks_detailed }} / {{ d.meta.blocks_total }} 块</td></tr>
            <tr><th>耗时</th><td>{{ d.meta.elapsed_ms }} ms</td></tr>
            {% if d.report.notes_for_human %}
            <tr><th>不确定的地方</th><td>{{ d.report.notes_for_human }}</td></tr>
            {% endif %}
            {% if d.meta.issues %}
            <tr><th>校验提示</th><td>{% for i in d.meta.issues %}<div>· {{ i }}</div>{% endfor %}</td></tr>
            {% endif %}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  <footer>What-I-Did · 截图与 OCR 全部在本机完成，仅文本摘要发送给模型</footer>
</div>

<div id="lightbox"><img id="lightbox-img" alt=""></div>
<script>
(function () {
  var lb = document.getElementById('lightbox');
  var lbi = document.getElementById('lightbox-img');
  document.addEventListener('click', function (e) {
    var t = e.target.closest('[data-img]');
    if (t) { lbi.src = t.getAttribute('data-img'); lb.classList.add('on'); e.preventDefault(); return; }
    if (e.target === lb || e.target === lbi) { lb.classList.remove('on'); lbi.src = ''; }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') lb.classList.remove('on'); });

  var s = document.getElementById('tl-search');
  if (s) {
    s.addEventListener('input', function () {
      var q = s.value.trim().toLowerCase();
      document.querySelectorAll('#tl-list tr').forEach(function (tr) {
        var txt = tr.getAttribute('data-text') || tr.textContent.toLowerCase();
        tr.style.display = (!q || txt.indexOf(q) >= 0) ? '' : 'none';
      });
    });
  }
  // 从正文点证据编号跳到折叠附录时，先把对应折叠块展开
  document.addEventListener('click', function (e) {
    var a = e.target.closest('a.ev');
    if (!a) return;
    var target = document.getElementById((a.getAttribute('href') || '').slice(1));
    if (!target) return;
    var box = target.closest('details');
    while (box) { box.open = true; box = box.parentElement && box.parentElement.closest('details'); }
    setTimeout(function () { target.scrollIntoView({ block: 'center', behavior: 'smooth' }); }, 30);
    e.preventDefault();
  });
})();
</script>
</body>
</html>
