{% if rv.todos %}
## {{ t("Open items & blockers") }}

{% for item in rv.todos %}- **{{ {'waiting': t("Waiting on others"), 'blocked': t("Blocked"), 'todo': t("To do")}.get(item.kind, t("To do")) }}** {{ item.item }}{{ " — " ~ item.why if item.why else "" }}
{% endfor %}
{% endif %}
{% if rv.tasks %}
## {{ t("Main threads") }}

> [!info] {{ t("{segments} merged by thread into {n} threads", segments=tn(rv.task_notes.segments, "{n} work segment", "{n} work segments"), n=rv.task_notes.tasks) }}
