---
title: "{{ t("{day} daily report", day=day) }}"
date: {{ day }}
type: daily-report
weekday: {{ weekday }}
active_minutes: {{ d.stats.active_minutes }}
blocks: {{ d.stats.block_count }}
longest_focus_min: {{ ((d.stats or {}).get('rhythm') or {}).get('longest_focus_min', 0) }}
status: {{ d.status }}
confidence: {{ d.report.confidence }}
tags:
  - daily-report
  - what-i-did
---

