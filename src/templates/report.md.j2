{% endif %}
| {{ t("Time") }} | {{ t("Duration") }} | {{ t("What was happening") }} | {{ t("Outcome") }} |
|---|---|---|---|
{% for task in rv.tasks %}| {{ task.start }}–{{ task.end }} | {{ t("{n} min", n=task.minutes) }} | **{{ task.label }}**{{ " · " ~ task.detail if task.detail else "" }} | {{ task.outcome or "—" }} |
{% endfor %}
{% endif %}
