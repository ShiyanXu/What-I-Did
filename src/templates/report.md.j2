{% endif %}
{% if d.report.insight %}
## {{ t("Additional observations") }}

{% for it in d.report.insight %}- **{{ it.observation }}**{{ " · " ~ t("Basis: {body}", body=it.evidence) if it.evidence else "" }}{{ " · " ~ t("Next time: {body}", body=it.action) if it.action else "" }}
{% endfor %}
{% endif %}
{% if d.report.friction %}
## {{ t("Blockers & cost") }}

{% for it in d.report.friction %}- **{{ it.what }}**{{ " · " ~ t("Cause: {body}", body=it.cause) if it.cause else "" }}{{ " · " ~ t("Cost: {body}", body=it.cost) if it.cost else "" }}{{ " · " ~ t("Handling: {body}", body=it.fix) if it.fix else "" }}
{% endfor %}
{% endif %}
