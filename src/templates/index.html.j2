<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>What-I-Did · {{ t("Work report dashboard") }}</title>
{% include "_style.html.j2" %}
</head>
<body>
<div class="wrap">

  <header class="hero">
    <div class="hero-top">
      <h1>{{ t("Work report dashboard") }}<span class="wd">What-I-Did</span></h1>
      <div class="badges">
        {% if paused %}<span class="badge warn">{{ t("Capture paused") }}</span>
        {% elif hb_age is not none and hb_age < 180 %}<span class="badge ok">{{ t("Capturing") }}</span>
        {% elif hb_age is not none %}<span class="badge bad">{{ t("Capture may have stopped") }}</span>
        {% else %}<span class="badge">{{ t("Not started") }}</span>{% endif %}
        {% if hb_age is not none %}<span class="badge">{{ t("Heartbeat {n}s ago", n=hb_age) }}</span>{% endif %}
        {% if free_gb is not none %}<span class="badge">{{ t("Disk {n} GB", n=free_gb) }}</span>{% endif %}
        <span class="badge {{ 'ok' if has_key else 'warn' }}">{{ t("Model configured") if has_key else t("No API key") }}</span>
      </div>
    </div>
    <p class="headline">
      {% if heartbeat and heartbeat.state not in (none, '', 'active') %}
        {{ t("Current state:") }} {{ {'idle': t("Idle, capture paused"), 'locked': t("Screen locked, capture paused"), 'paused': t("Paused by hand"), 'blocked_app': t("Current window is on the blocklist; capture paused"), 'blocked_title': t("Current window title matched a privacy rule; capture paused"), 'low_disk': t("Low disk space; writing stopped")}.get(heartbeat.state, heartbeat.state) }}
      {% elif heartbeat %}
        {{ t("Last sample at {at}, {shots} kept today", at=heartbeat.get('last_event', ''), shots=tn(heartbeat.get('shots_today', 0), "{n} screenshot", "{n} screenshots")) }}
      {% else %}
        {{ t("The capture process has not reported a heartbeat yet. Run") }} <span class="mono">python wid.py daemon</span> {{ t("or install the scheduled task to start recording.") }}
      {% endif %}
    </p>
  </header>

  <section>
    <h2>{{ t("Last 30 days") }} <span class="sub">{{ t("Darker means more active time; a red dot is a missing report") }}</span></h2>
    <div style="display:flex;gap:5px;flex-wrap:wrap;margin:6px 0 10px">
      {% for h in heat %}
        {% set colors = ['#eef2f7', '#dbeafe', '#bfdbfe', '#60a5fa', '#2563eb'] %}
        {% if h.has %}
        <a href="day/{{ h.day }}.html" title="{{ h.day }} · {{ t("{n} min", n=h.minutes) }}" style="flex:1;min-width:22px;height:34px;border-radius:5px;background:{{ colors[h.level] }};position:relative;display:block"></a>
        {% elif h.missing %}
        <span title="{{ h.day }} · {{ t("no record") }}" style="flex:1;min-width:22px;height:34px;border-radius:5px;background:#fef2f2;border:1px dashed #fecaca;display:block"></span>
        {% else %}
        <span title="{{ h.day }} · {{ t("no record") }}" style="flex:1;min-width:22px;height:34px;border-radius:5px;background:#f1f3f7;display:block"></span>
        {% endif %}
      {% endfor %}
    </div>
    <div class="ticks"><span>{{ heat[0].day if heat }}</span><span>{{ heat[-1].day if heat }}</span></div>
  </section>

  <section>
    <h2>{{ t("Reports") }} <span class="sub">{{ tn(reports | length, "{n} report", "{n} reports") }}</span></h2>
    <input class="search" id="rpt-search" placeholder="{{ t('Search: project, outcome, date…') }}">
    <table id="rpt-table">
      <thead><tr><th style="width:104px">{{ t("Date") }}</th><th>{{ t("Headline") }}</th><th style="width:58px">{{ t("Time") }}</th><th style="width:58px">{{ t("Outcomes") }}</th><th style="width:74px">{{ t("Status") }}</th></tr></thead>
      <tbody>
      {% for r in reports %}
        <tr data-text="{{ (r.day ~ ' ' ~ r.headline)|lower }}">
          <td><a class="mono" href="day/{{ r.day }}.html">{{ r.day }}</a><div style="font-size:11px;color:#9ca3af">{{ r.weekday }}</div></td>
          <td>{{ r.headline or t("(untitled)") }}</td>
          <td class="mono">{{ (r.minutes / 60) | round(1) }}h</td>
          <td class="mono">{{ r.acc }}</td>
          <td>
            {% if r.status == 'ok' %}<span class="badge ok">{{ t("OK") }}</span>
            {% elif r.status == 'degraded' %}<span class="badge warn">{{ t("Degraded") }}</span>
            {% else %}<span class="badge">{{ t("Empty day") }}</span>{% endif %}
          </td>
        </tr>
      {% else %}
        <tr><td colspan="5" class="empty">{{ t("No reports yet. The first one is generated at 21:00, or run it by hand:") }} <span class="mono">python wid.py report</span></td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <footer>{{ t("Generated {time} · all data stays on this machine · refreshed daily at 21:00", time=now.strftime('%Y-%m-%d %H:%M')) }}</footer>
</div>
<script>
(function () {
  var s = document.getElementById('rpt-search');
  if (!s) return;
  s.addEventListener('input', function () {
    var q = s.value.trim().toLowerCase();
    document.querySelectorAll('#rpt-table tbody tr').forEach(function (tr) {
      var txt = tr.getAttribute('data-text') || tr.textContent.toLowerCase();
      tr.style.display = (!q || txt.indexOf(q) >= 0) ? '' : 'none';
    });
  });
})();
</script>
</body>
</html>
